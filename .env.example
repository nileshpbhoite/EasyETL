# Copy to .env and adjust. Every setting is optional for a local demo.

# Security — always change in shared environments
EASYETL_JWT_SECRET=change-me-to-a-long-random-string
# Fernet key for encrypting credentials at rest (generated automatically if omitted):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EASYETL_SECRETS_KEY=
EASYETL_ALLOW_DEMO_LOGIN=true
EASYETL_SEED_DEMO=true

# Databricks — leave empty to run deployments in safe simulation mode
EASYETL_DATABRICKS_HOST=
EASYETL_DATABRICKS_TOKEN=

# Optional: add Claude on top of the deterministic recommendation engine
EASYETL_AI_PROVIDER=heuristic
EASYETL_ANTHROPIC_API_KEY=
